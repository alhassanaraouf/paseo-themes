		"check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@getpaseo/plugin": "0.9.1",
		"typescript": "^5.9.0",
		"vitest": "^3.0.0"
	},
	"packageManager": "bun@1.4.2"
}
