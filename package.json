{
	"name": "paseo-themes",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "100 community themes for Paseo, ported from the most popular Obsidian themes. Each theme is a standalone paseo.cafe-ready plugin.",
	"workspaces": [
